PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback

SESSION_SECRET=generate-with-openssl-rand-hex-32
TOKEN_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Phase 2 Step 6d, refresh-token encryption at rest.
#
# Leave all four empty in development and TOKEN_ENCRYPTION_KEY above is used on
# its own, which is a supported path rather than a fallback. Set them and the
# data key is unwrapped from Cloud KMS once at boot and held in memory: KMS holds
# the key, the deployment holds only TOKEN_KEY_WRAPPED, which is inert without
# KMS access. Production refuses to boot without the two required ones.
#
# Keep TOKEN_ENCRYPTION_KEY set alongside them through the cutover — it decrypts
# rows written before the swap, which carry no key id. It can be dropped once no
# such rows remain.
#
# TOKEN_KMS_KEY_NAME is the full resource name:
#   projects/<project>/locations/northamerica-northeast1/keyRings/<ring>/cryptoKeys/<key>
# TOKEN_KMS_CREDENTIALS is the service-account JSON on one line. Empty means
# Application Default Credentials, which is right anywhere the platform supplies
# an identity and wrong on DigitalOcean, which does not.
# TOKEN_KEY_WRAPPED is the base64 KMS ciphertext of a 32-byte data key; generate
# it once with the wrapKey helper in src/services/kms.ts.
# TOKEN_KEY_ID names the key in each payload it writes, so a key can be rotated
# out of active use while rows it wrote still decrypt. Change it only when
# rotating, and never reuse an old id for new material.
TOKEN_KMS_KEY_NAME=
TOKEN_KMS_CREDENTIALS=
TOKEN_KEY_WRAPPED=
TOKEN_KEY_ID=k1

# Phase 2 Step 6d, read-side working set budget in megabytes. Measured against a
# 1 GiB instance, where Node settles near 512 MB of usable heap and one teacher
# costs about 8 MB. Raising the instance means raising this, or the extra memory
# goes unused. Re-derive with `node --expose-gc scripts/measure-working-set.mjs`.
CACHE_MAX_MB=256

# Phase 2 account model. Points at a local Postgres (native install) holding
# account rows only — no student PII. The users table is created automatically
# at boot by the migration runner; you only create the empty database.
DATABASE_URL=postgresql://postgres:password@localhost:5432/teacher_toolkit

# Phase 2 Step 6d. PEM of the CA that signed the database server's certificate,
# with line breaks written as literal \n. Empty locally, where Postgres is a
# native install with no TLS. Required in production: DigitalOcean's managed
# Postgres presents a certificate from DigitalOcean's own CA, and `pg` treats
# sslmode=require as verify-full, so an empty value fails every query with
# "self-signed certificate in certificate chain". The deployed value lives in
# .do/app.yaml, since a CA certificate is public.
DATABASE_CA_CERT=

# Phase 2 Step 3b, billing. Test-mode values during development — the dashboard's
# test/live toggle decides which you are copying, and a live key here would take
# real money. There is no publishable key: checkout is Stripe-hosted, so the
# browser never talks to Stripe and the client needs no key of its own.
#
# STRIPE_WEBHOOK_SECRET is per endpoint, not per account: locally it is the value
# `stripe listen` prints on startup, and in production it is the one the dashboard
# issues for the deployed endpoint. Same name, different value per environment.
#
# The price ids are not secrets. They live here because test-mode and live-mode
# ids differ, and hardcoding one guarantees a wrong-mode bug later.
STRIPE_SECRET_KEY=sk_test_your-stripe-test-secret-key
STRIPE_WEBHOOK_SECRET=whsec_from-stripe-listen-or-the-dashboard-endpoint
STRIPE_PRICE_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_ANNUAL=price_your-annual-price-id

# Phase 2 Step 3, development only. Comma-separated Google `sub` values allowed
# to use the account-menu plan toggle (POST /internal/dev/plan). The endpoint
# additionally refuses whenever NODE_ENV=production, so both guards must pass;
# leave this empty to disable the toggle entirely.
DEV_TOOLS_GOOGLE_SUBS=

# Phase 2 Steps 4 and 6j. Comma-separated Google `sub` values allowed to reach
# the operator surface: support triage and the comp lever (/admin/support), and
# the activation metrics view (/admin/metrics). It also drives `supportAdmin` on
# GET /auth/me, so leaving it empty hides both links from the account menu as
# well as 404-ing the routes. Unlike DEV_TOOLS_GOOGLE_SUBS this has
# no NODE_ENV half to its guard — support triage is a production task — so the
# allowlist is the whole guard. Leave empty and the admin endpoints answer 404
# for everyone, which is also what a non-allowlisted account sees.
SUPPORT_ADMIN_GOOGLE_SUBS=

# Phase 2 Step 6h, lifecycle email. Leave both empty and the app prints each
# message to the server console instead of sending it, which is the intended
# state for local work — outside production only, since a production deployment
# with no provider refuses to sweep rather than discarding a teacher's
# trial-expiry notice.
#
# `teachneat.com` is verified with Resend as of 2026-08-27, so a real key here
# sends from the real address. Without a verified domain Resend accepts
# `onboarding@resend.dev` and delivers only to the account owner's address.
#
# Setting these locally against the production database would drain that
# deployment's queue to real recipients. Point at a local database, or leave
# them empty.
RESEND_API_KEY=
# `Teachneat <address>` in production, so the sender reads as the product rather
# than as a bare mailbox. Resend accepts the display-name form directly.
LIFECYCLE_EMAIL_FROM=onboarding@resend.dev

# Where a reply goes when the from address above is not a mailbox that receives.
# Optional: empty omits the header entirely rather than sending an empty one.
LIFECYCLE_REPLY_TO=

# Phase 2 Step 6d, operator alerting. Where unhandled 5xx responses, unhandled
# rejections and uncaught exceptions are mailed. An operator address, never a
# teacher-facing one.
#
# Empty disables the alert and not the log, which is the correct state until the
# sending domain is verified — the same condition that keeps RESEND_API_KEY empty
# above. Alerting shares that sender, so with no provider configured the alerts
# print to the console alongside the lifecycle mail.
#
# The payload is fixed and hand-built: method, router mount path, status, error
# class, and the top stack frame. The error message is deliberately not included,
# because messages interpolate the data that caused them; it stays in the log.
OPERATOR_ALERT_EMAIL=

# How many proxies sit in front of the app, for Express's `trust proxy`.
# Leave at 0 locally: there is no proxy, and `req.ip` is already the caller.
#
# In a deployment this must be MEASURED rather than guessed. Too low and every
# IP-keyed rate limiter degrades into one bucket shared by all traffic; too high
# and Express reads `req.ip` out of client-supplied X-Forwarded-For, letting a
# caller pick their own bucket. GET /api/internal/forwarding (operator-gated)
# reports the live chain so the right number can be read off it.
TRUST_PROXY_HOPS=0
