{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npm audit*)",
      "Bash(npm ls*)",
      "Bash(npx tsc*)",
      "Bash(npx vitest*)",
      "Bash(npx playwright*)",
      "Bash(npx eslint*)",
      "Bash(npx prettier*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git push origin main:main)",
      "Bash(git push --force-with-lease*)",
      "Bash(git fetch*)",
      "Bash(git pull --ff-only*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git branch)",
      "Bash(git branch -v*)",
      "Bash(git branch --list*)",
      "Bash(git merge --ff-only*)",
      "Bash(git stash*)",
      "Bash(git worktree list*)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh repo view*)",
      "Bash(ls*)",
      "Bash(pwd)",
      "Bash(mkdir*)",
      "Bash(cat package.json)",
      "Bash(cat tsconfig.json)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push -f*)",
      "Bash(git push --force *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean -df*)",
      "Bash(git clean -fd*)",
      "Bash(git branch -D*)",
      "Bash(git checkout -- *)",
      "Bash(git restore --staged --worktree*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "node .claude/hooks/protect-planning-docs.mjs"
          }
        ]
      }
    ]
  }
}
