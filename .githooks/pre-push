#!/bin/sh
#
# Runs the same checks CI runs, before the push rather than after it.
#
# A push to main deploys production, so a failure caught here costs thirty
# seconds and a failure caught in CI costs a round trip plus a red badge. The
# checks are deliberately identical to .github/workflows/ci.yml — if they drift,
# this hook stops being worth trusting.
#
# Docs-only pushes skip the checks, mirroring the paths-ignore in the workflow.
#
# Bypass with `git push --no-verify` when you genuinely mean to.

set -e

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

ZERO=0000000000000000000000000000000000000000

# Gather every file this push would send. stdin carries one line per ref:
#   <local ref> <local sha> <remote ref> <remote sha>
changed=""
saw_ref=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion, nothing to check
  saw_ref=1
  if [ "$remote_sha" = "$ZERO" ]; then
    # New branch on the remote: compare against main where we can.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
    if [ -n "$base" ]; then
      files=$(git diff --name-only "$base" "$local_sha" 2>/dev/null || echo "")
    else
      files=""
    fi
  else
    files=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || echo "")
  fi
  changed="$changed
$files"
done

if [ "$saw_ref" = "0" ]; then
  exit 0
fi

# Anything outside docs and design assets means the checks have to run. An empty
# file list means we could not work it out, so run them rather than assume.
needs_checks=0
if [ -z "$(printf '%s' "$changed" | tr -d '[:space:]')" ]; then
  needs_checks=1
else
  # Read line by line rather than word-splitting: the repo has at least one
  # tracked path containing spaces.
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    case "$f" in
      *.md|design/*|.gitignore|LICENSE) ;;
      *) needs_checks=1 ;;
    esac
  done <<EOF
$changed
EOF
fi

if [ "$needs_checks" = "0" ]; then
  echo "pre-push: documentation only, skipping checks."
  exit 0
fi

echo "pre-push: running server checks..."
cd "$ROOT/server"
npm run typecheck
npm test
npm run build

echo "pre-push: running client checks..."
cd "$ROOT/client"
npm run lint
npm run typecheck
npm test
npm run build

echo "pre-push: all checks passed."
